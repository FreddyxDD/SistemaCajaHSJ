APP_NAME="Gestion Caja HSJ"
APP_ENV=local
APP_TIMEZONE=America/Lima
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base propia de la aplicacion (migraciones, auditoria, notificaciones y anulaciones).
DB_CONNECTION=sqlsrv
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DATABASE=HSJ_Caja
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Identidad central: usuarios, roles y permisos compartidos por las aplicaciones HSJ.
IDENTITY_DB_HOST="${DB_HOST}"
IDENTITY_DB_PORT=
IDENTITY_DB_DATABASE=HSJ_Identity
IDENTITY_DB_USERNAME=
IDENTITY_DB_PASSWORD=
IDENTITY_DB_TRUST_SERVER_CERTIFICATE=true

# Operacion de caja legada (lectura y escritura).
CAJA_DB_HOST="${DB_HOST}"
CAJA_DB_PORT=
CAJA_DB_DATABASE=SISGESH_BD
CAJA_DB_USERNAME=
CAJA_DB_PASSWORD=
CAJA_DB_TRUST_SERVER_CERTIFICATE=true

# Selector por sesion entre la copia local y la base real institucional.
CAJA_DB_SWITCH_ENABLED=false
CAJA_DB_DEFAULT=development

CAJA_DEV_DB_HOST="${CAJA_DB_HOST}"
CAJA_DEV_DB_PORT="${CAJA_DB_PORT}"
CAJA_DEV_DB_DATABASE="${CAJA_DB_DATABASE}"
CAJA_DEV_DB_USERNAME="${CAJA_DB_USERNAME}"
CAJA_DEV_DB_PASSWORD="${CAJA_DB_PASSWORD}"
CAJA_DEV_DB_TRUST_SERVER_CERTIFICATE=true

CAJA_INSTITUTIONAL_DB_HOST=
CAJA_INSTITUTIONAL_DB_PORT=
CAJA_INSTITUTIONAL_DB_DATABASE=SISGESH_BD
CAJA_INSTITUTIONAL_DB_USERNAME=
CAJA_INSTITUTIONAL_DB_PASSWORD=
CAJA_INSTITUTIONAL_DB_TRUST_SERVER_CERTIFICATE=true

# Historia clinica y datos de pacientes (solo lectura desde la aplicacion).
SIGH_DB_HOST="${DB_HOST}"
SIGH_DB_PORT=
SIGH_DB_DATABASE=SIGH
SIGH_DB_USERNAME=
SIGH_DB_PASSWORD=
SIGH_DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
